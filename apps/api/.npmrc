# Force hoisted (npm-style) node_modules layout for the api workspace
# so Vercel's NFT (node file tracing) can follow normal `require` paths
# without resolving pnpm's symlinks. Without this, the function bundle
# ships without node_modules at all, and the runtime fails with
# "Cannot find module '@sentry/nestjs'" the moment it tries to require
# any dependency.
#
# This file only affects pnpm operations from inside apps/api/ — root
# installs still use the workspace's default (isolated) layout.
node-linker=hoisted
