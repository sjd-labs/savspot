{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ../.. && pnpm turbo build --filter=@savspot/api...",
  "installCommand": "cd ../.. && NODE_OPTIONS='--max-old-space-size=7000' pnpm install --filter=@savspot/api... --frozen-lockfile --ignore-scripts --child-concurrency=1",
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.ts": {
      "memory": 1024,
      "maxDuration": 300
    }
  }
}
